# คัดลอกเป็น .env แล้วเติมค่า — ไฟล์นี้ commit ได้ (ห้ามใส่ค่าจริง)
#
# ค่า default ชี้ Postgres ในเครื่อง ไม่ใช่ production
# ตั้ง dev ครั้งแรก:
#   brew install postgresql@18 && brew services start postgresql@18
#   createdb pssms_dev
#   node db/seed-dev.js
DATABASE_URL=postgresql://localhost:5432/pssms_dev

JWT_SECRET=ใส่ค่าสุ่มยาว ๆ
PORT=3000

# legacy — sheets.js ใช้ตอน migration เท่านั้น ไม่ใช่ runtime
SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_KEY_FILE=credentials.json

# ที่เก็บไฟล์ PDF ของสื่อการสอน — production ต้องชี้ไป mount path ของ Railway Volume
# ไม่ตั้ง = เขียนลง ./storage/media ซึ่งบน Railway เป็น filesystem ชั่วคราว ไฟล์หายทุก deploy
MEDIA_STORAGE_DIR=

# ต่อ production ให้ทำแบบ opt-in ต่อคำสั่ง อย่าตั้งไว้ใน .env
#   DATABASE_URL=$(node -e "require('dotenv').config({path:'.env.prod'});process.stdout.write(process.env.DATABASE_URL)") node <script>
# เก็บ URL จริงไว้ใน .env.prod (gitignored)
